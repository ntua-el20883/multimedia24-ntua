{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch App",
            "request": "launch",
            "mainClass": "app.App",
            "vmArgs": "--module-path lib/javafx-sdk-23.0.1/lib --add-modules javafx.controls",
            "classpath": [
                "bin",
                "lib/javafx-sdk-23.0.1/lib/*",
                "lib/jackson-annotations-2.18.1.jar",
                "lib/jackson-core-2.18.1.jar",
                "lib/jackson-databind-2.18.1.jar"
            ]
        }
    ]
}
